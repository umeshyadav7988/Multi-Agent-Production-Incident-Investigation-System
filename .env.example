# ---------------------------------------------------------------------------
# Reasoning engine
#   heuristic : deterministic, offline, zero-cost. Default. CI and tests use it.
#   llm       : real model calls. Requires one provider key below.
# ---------------------------------------------------------------------------
ENGINE=heuristic

# --- Provider credentials --------------------------------------------------
# Set ONE. Auto-detected in this order: Groq, AI Gateway, Anthropic.
# Override the choice explicitly with LLM_PROVIDER=groq|gateway|anthropic.

GROQ_API_KEY=
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=

# LLM_PROVIDER=groq

# Model id. Defaults per provider if unset:
#   groq      -> openai/gpt-oss-120b
#   gateway   -> anthropic/claude-sonnet-5-5
#   anthropic -> claude-sonnet-5-5
MODEL_ID=

# --- Provider rate limiting ------------------------------------------------
# Tokens-per-minute cap to respect client-side. 0 or unset disables throttling.
# Hosted inference is usually capped on TPM, not just requests; discovering
# that by absorbing 429s burns the retry budget and looks like the model
# reasoning badly rather than never having run.
#
# Groq free tier is 8000 TPM at the time of writing. Check yours with:
#   curl -sD - -o /dev/null https://api.groq.com/openai/v1/chat/completions \
#     -H "Authorization: Bearer $GROQ_API_KEY" -H 'Content-Type: application/json' \
#     -d '{"model":"openai/gpt-oss-120b","messages":[{"role":"user","content":"hi"}],"max_tokens":5}' \
#     | grep -i x-ratelimit
LLM_TOKENS_PER_MINUTE=

# Output tokens per minute, when the provider caps output separately. This is
# usually the binding limit for this workload: a reasoning step writes a lot.
# Groq free tier allows 1000 OTPM against 8000 TPM, which is below what one
# hypothesis-generation call needs to write.
LLM_OUTPUT_TOKENS_PER_MINUTE=

# --- Simulation ------------------------------------------------------------
# Probability that any single tool call fails or returns partial data (0..1)
TOOL_FAULT_RATE=0.12

# Deterministic seed for synthetic data and fault injection
SEED=20260401
