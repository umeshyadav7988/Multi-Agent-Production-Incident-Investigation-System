{
  "name": "incident-investigator",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-agent production incident investigation system with a single-agent baseline and an evaluation harness.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "investigate": "tsx src/cli.ts investigate",
    "list": "tsx src/cli.ts list",
    "show": "tsx src/cli.ts show",
    "eval": "tsx src/cli.ts eval",
    "eval:quick": "tsx src/cli.ts eval --mode heuristic",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.98",
    "@ai-sdk/groq": "^4.0.78",
    "@vercel/config": "^0.14.1",
    "ai": "^7.0.164",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
